{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "LWSSETTINGS_LWS_SOURCE_DIR": "${sourceDir}/../LWS",
        "LWSSETTINGS_JSON_SOURCE_DIR": "${sourceDir}/../LWS/build/rebase-deps/json",
        "FETCHCONTENT_SOURCE_DIR_CATCH2": "${sourceDir}/../LWS/build/_deps/catch2-src",
        "LWS_BUILD_TESTS": "ON",
        "LWS_BUILD_UI": "ON",
        "LWSUI_BUILD_DEMO": "ON",
        "LWSSETTINGS_BUILD_TESTS": "ON",
        "LWSSETTINGS_BUILD_DEMO": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_FLAGS": "/EHsc",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG"
      }
    },
    {
      "name": "wayland-release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "wayland-asan",
      "inherits": "wayland-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "LWSUI_BUILD_DEMO": "OFF",
        "LWSSETTINGS_BUILD_DEMO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 4
    },
    {
      "name": "wayland-release",
      "configurePreset": "wayland-release",
      "jobs": 4
    },
    {
      "name": "wayland-asan",
      "configurePreset": "wayland-asan",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 40
      }
    },
    {
      "name": "wayland-release",
      "configurePreset": "wayland-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 40
      }
    },
    {
      "name": "wayland-asan",
      "configurePreset": "wayland-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 40
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "UBSAN_OPTIONS": "halt_on_error=1"
      }
    }
  ]
}
